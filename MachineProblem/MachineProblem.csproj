<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <RootNamespace>DreamOS.WinForms</RootNamespace>
    <ApplicationManifest>DreamOS.WinForms/app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Build the desktop sources only; the nested core and test projects are separate assemblies. -->
  <ItemGroup>
    <Compile Include="DreamOS.WinForms/**/*.cs"
             Exclude="DreamOS.WinForms/**/bin/**;DreamOS.WinForms/**/obj/**" />
    <ProjectReference Include="DreamOS.Core/DreamOS.Core.csproj" />
    <Content Include="DreamOS/04_Guide_Character/Guide_Original_Reference.jpg"
             Link="Assets/Guide.jpg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>


  <ItemGroup>
    <Content Include="DreamOS/03_Desktop_Login_Widgets/Login_Design.png" Link="Assets/Login.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="DreamOS/03_Desktop_Login_Widgets/Desktop_Overview.png" Link="Assets/Desktop.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="DreamOS/03_Desktop_Login_Widgets/Desktop_Widgets.png" Link="Assets/Widgets.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="DreamOS/02_App_Window_Concept_Crops/Pizza_Builder.png" Link="Assets/Pizza.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="DreamOS/02_App_Window_Concept_Crops/Lotto_Game.png" Link="Assets/Lotto.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="DreamOS/02_App_Window_Concept_Crops/Tuition_Fees.png" Link="Assets/Tuition.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="DreamOS/02_App_Window_Concept_Crops/Hotel_Billing.png" Link="Assets/Hotel.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup><Content Include="DreamOS.WinForms/Assets/WorkflowSprites.png" Link="Assets/WorkflowSprites.png" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
